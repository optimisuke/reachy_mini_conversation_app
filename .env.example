# Optional input transcription language.
# Defaults to "en". The deployed Hugging Face realtime backend ignores this; the
# direct backend passes it to its speech-to-text endpoint, so "ja" works there.
# REALTIME_TRANSCRIPTION_LANGUAGE="en"

# Conversation backend: "huggingface" (realtime websocket, the default) or "direct".
# The direct backend detects speech locally and calls speech-to-text, a language
# model and text-to-speech itself, which is how Japanese becomes usable.
# CONVERSATION_BACKEND="direct"

# --- direct backend ---
# Key for the OpenAI-compatible speech endpoints (transcription and synthesis).
# OPENAI_API_KEY=

# Per-stage overrides. Each stage speaks the OpenAI HTTP API, so pointing a base URL
# at another provider (a local Kokoro speech server, say) is all it takes to swap it.
# DIRECT_STT_MODEL="gpt-transcribe"
# DIRECT_STT_BASE_URL=
# DIRECT_STT_API_KEY=
# DIRECT_LLM_MODEL="Qwen/Qwen3-4B-Instruct-2507"
# DIRECT_LLM_BASE_URL="https://router.huggingface.co/v1"
# Falls back to HF_TOKEN (the default endpoint is the Hugging Face router), then OPENAI_API_KEY.
# DIRECT_LLM_API_KEY=
# Show camera pictures to the language model. Off by default because the default
# model reads text only; with it off, Reachy says it cannot see rather than guessing.
# DIRECT_LLM_VISION=1
# DIRECT_TTS_MODEL="gpt-4o-mini-tts"
# DIRECT_TTS_BASE_URL=
# DIRECT_TTS_API_KEY=
# Sample rate of the PCM the synthesis endpoint returns.
# DIRECT_TTS_SAMPLE_RATE=24000
# Provider voice id, bypassing the app's voice catalog mapping.
# DIRECT_TTS_VOICE=

# Voice activity detection thresholds. Levels are RMS (0..1) and ratios are
# multiples of the tracked noise floor; the barge-in values apply while Reachy talks.
# DIRECT_VAD_MIN_LEVEL=0.006
# DIRECT_VAD_BARGE_IN_MIN_LEVEL=0.012
# DIRECT_VAD_SPEECH_START_RATIO=3.0
# DIRECT_VAD_BARGE_IN_RATIO=6.0
# DIRECT_VAD_SPEECH_START_S=0.12
# DIRECT_VAD_BARGE_IN_START_S=0.3
# DIRECT_VAD_SILENCE_END_S=0.45
# Start transcribing at this much silence, before the turn is confirmed, so the
# request overlaps the rest of the wait. The work is discarded if talking resumes.
# Set to 0 to transcribe only once, at the end of the turn.
# DIRECT_VAD_SPECULATIVE_SILENCE_S=0.18
# DIRECT_VAD_PREROLL_S=0.3
# DIRECT_VAD_MIN_UTTERANCE_S=0.25
# DIRECT_VAD_MAX_UTTERANCE_S=20.0

# Hugging Face connection mode: "deployed" or "local".
# Deployed mode uses the built-in Hugging Face server.
# Defaults to "deployed" when unset.
# HF_REALTIME_CONNECTION_MODE="deployed"

# Direct Hugging Face realtime endpoint for local/LAN backends.
# Accepts either the base URL (`ws://127.0.0.1:8765/v1`) or the full realtime URL
# (`ws://127.0.0.1:8765/v1/realtime`). Used when HF_REALTIME_CONNECTION_MODE=local.
# HF_REALTIME_WS_URL="ws://127.0.0.1:8765/v1/realtime"

# Hugging Face token for accessing datasets/models
HF_TOKEN=

# Optional built-in profile selector. Use a folder name from profiles/.
# If unset, the app uses the default profile unless startup settings were saved from the UI.
# REACHY_MINI_CUSTOM_PROFILE=mars_rover

# Optional external profile/tool directories
# REACHY_MINI_EXTERNAL_PROFILES_DIRECTORY=external_content/external_profiles
# REACHY_MINI_EXTERNAL_TOOLS_DIRECTORY=external_content/external_tools

# Optional: discover and auto-load all tools found in REACHY_MINI_EXTERNAL_TOOLS_DIRECTORY,
# even if they are not enabled by the selected profile or its Tool access override.
# This is convenient for downloaded tools used with built-in/default profiles.
# AUTOLOAD_EXTERNAL_TOOLS=1

# Minutes of inactivity before Reachy goes to sleep and the app stops. Default 1440 (one day), 0 disables.
# REACHY_MINI_APP_TIMEOUT_MINUTES=1440
